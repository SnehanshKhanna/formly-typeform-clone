# Backend Environment Variables

# Database URL for SQLite.
# Local development: sqlite:///./formly.db
# Render with persistent disk: sqlite:////data/formly.db
DATABASE_URL=sqlite:///./formly.db

# Allowed CORS Origins (comma-separated URLs or JSON array)
CORS_ORIGINS=http://localhost:3000,http://localhost:3100,https://formly-typeform-clone.vercel.app

# Environment mode: development or production
ENV=development

# Port (configured automatically by Render)
PORT=8000
